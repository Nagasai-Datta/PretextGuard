# Copy this file to .env and put real values there. Never commit .env.
# The API (Phase 11) refuses to start with the placeholder below, with a key under 24 characters, or with no key.
# Make a key:   python -m src.api.settings --new-key        Check the settings:   python -m src.api.settings
PRETEXTGUARD_API_KEY=change-me

# Optional API settings; the values shown are the defaults. The size caps are fixed in src/api/settings.py and cannot be set here.
# PRETEXTGUARD_RATE_ANALYZE=30/minute
# PRETEXTGUARD_RATE_EXPLAIN=6/minute
# PRETEXTGUARD_RATE_GLOBAL=120/minute
# PRETEXTGUARD_EXPLAIN_SAMPLES=150
# PRETEXTGUARD_WAIT_SECONDS=2
# PRETEXTGUARD_ALLOWED_HOSTS=127.0.0.1,localhost
# PRETEXTGUARD_ENABLE_DOCS=0
# PRETEXTGUARD_HOST=127.0.0.1
# PRETEXTGUARD_PORT=8000

# Phase 5: one free Gemini API key labels the emails (src/data/llm_api.py). Put the real key in .env, never here.
# The three roles each need a DIFFERENT model id. List the ids your key can use with:
#   python -m src.data.annotate check annotator_1
GEMINI_API_KEY=paste-your-key-here
ANNOTATOR_1_MODEL=
ANNOTATOR_2_MODEL=
TIEBREAKER_MODEL=
